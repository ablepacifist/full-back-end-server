# =============================================================================
# MASTER ENVIRONMENT TEMPLATE - copy to `.env` and fill in.
# `.env` is the single source of truth for every destination (ports, IPs,
# hostnames, tunnels) used by the scripts and by every module.
#
# LAYERING (lowest -> highest priority):
#   1. code defaults / each module's own .env (so a module runs standalone)
#   2. the root `.env` - overrides every module's own .env
#   3. real process environment variables
# Every module uses the SAME key names as here, so "override" just means
# "same key, the root file wins". Modules find the root file via
# $MASTER_ENV_FILE or a ../.env walk-up, and still run when it is absent.
#
# Format rules: KEY=value, one per line, no quotes, no inline comments,
# forward slashes in paths (Spring reads this as a .properties file).
# Secrets live ONLY in the real `.env` (git-ignored).
#
# SHIPPED TO CLIENTS: the web app and Android app bake in ONLY these keys:
#   LAN_HOST, ALISON_LAN_IP, FRONTEND_PORT, LEXICON_PORT, ALCHEMY_PORT,
#   POKEMON_PORT, BRAIN_LAN_PORT, PUBLIC_*, PLAYIT_*
# Never put a secret in any of those.
# =============================================================================

# ----- LAN topology ----------------------------------------------------------
LAN_HOST=192.168.1.4
ALISON_LAN_IP=192.168.1.2
PI_LAN_IP=192.168.1.8
BILBO_LAN_IP=192.168.1.11

# ----- Service ports on this machine (aragon) --------------------------------
FRONTEND_PORT=3001
LEXICON_PORT=36568
ALCHEMY_PORT=8080
POKEMON_PORT=8090
SERVER_ADDRESS=0.0.0.0
# HSQLDB host/port/name are derived from this URL by the scripts and servers.
DATABASE_URL=jdbc:hsqldb:hsql://localhost:9002/mydb

# ----- Lexi voice service ----------------------------------------------------
# LEXI_HOST is the bind address. LexiconServer reaches Lexi at 127.0.0.1:LEXI_PORT.
LEXI_HOST=0.0.0.0
LEXI_PORT=8765
# Obrenna (the brain) on alison listens on this port on the LAN.
BRAIN_LAN_PORT=9080
# Optional: offload Pi-side STT to a remote lexi-stt host (e.g. aragon,
# http://192.168.1.4:8765). Read by the Lexi-pi checkout only; blank = the Pi
# transcribes locally. Leave blank here unless the Pi actually offloads.
LEXI_STT_REMOTE_URL=

# ----- Public hostnames (Cloudflare tunnel - config lives in ~/.cloudflared) --
PUBLIC_FRONTEND_URL=https://alex-dyakin.com
PUBLIC_LEXICON_URL=https://api.alex-dyakin.com
PUBLIC_ALCHEMY_URL=https://alchemy.alex-dyakin.com
PUBLIC_POKEMON_URL=https://poke.alex-dyakin.com
PUBLIC_BRIDGE_URL=https://voice.alex-dyakin.com
PUBLIC_BRAIN_URL=https://llm.alex-dyakin.com

# ----- PlayIt tunnel (redundancy only; confirm on the playit.gg dashboard) ---
PLAYIT_HOST=209.25.140.16
PLAYIT_FRONTEND_PORT=1796
PLAYIT_ALCHEMY_PORT=1760
PLAYIT_LEXICON_PORT=1792
PLAYIT_POKEMON_PORT=1790

# ----- CORS ------------------------------------------------------------------
# Exact origins, comma-separated, no spaces. The servers ALSO allow
# http://LAN_HOST:* and http://PLAYIT_HOST:* automatically (derived above).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://alex-dyakin.com
# Wildcard patterns, comma-separated, no spaces.
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.alex-dyakin.com,http://*.playit.pub:*,http://*.with.playit.plus:*,http://*.gl.at.ply.gg:*,http://localhost:*,capacitor://localhost,https://localhost

# ----- PokemonServer ---------------------------------------------------------
POKEMON_SPRITES_PATH=C:/path/to/full-back-end-server/pokemon/pogo_assets/Images/Pokemon
POKEMON_ITEM_SPRITES_PATH=C:/path/to/full-back-end-server/pokemon/pogo_assets/Images/Items
POKEMON_ITEM_SPRITES_FALLBACK=C:/path/to/full-back-end-server/pokemon/moreAssets/pokesprite/items

# ----- LexiconServer ---------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB
# yt-dlp cookies (required for age-restricted content)
YTDLP_COOKIES_PATH=./cookies.txt

# ----- Web Push (VAPID) - generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ----- Android app self-update ----------------------------------------------
APP_UPDATE_VERSION_CODE=1
APP_UPDATE_VERSION_NAME=0.1.0
APP_UPDATE_DOWNLOAD_URL=https://api.example.com/api/app/download/latest
APP_UPDATE_APK_PATH=C:/path/to/full-back-end-server/releases/lexicon-latest.apk
APP_UPDATE_CRITICAL=false
APP_UPDATE_CHANGELOG=
APP_UPDATE_SHA256=
APP_UPDATE_PUBLIC_METADATA=false
APP_UPDATE_PUBLIC_DOWNLOAD=false

# ----- Lexi <-> LexiconServer shared secret (must equal Lexi/.tool_token) -----
LEXI_TOOL_TOKEN=

# ----- Backups (used only by backup-database.sh) -----------------------------
BACKUP_REMOTE_USER=
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_DIR=
